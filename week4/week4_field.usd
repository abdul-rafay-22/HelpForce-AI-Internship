def Xform "World"
{
    def DistantLight "SunLight"
    {
        float inputs:angle = 0.53
        color3f inputs:color = (1, 0.95, 0.88)
        float inputs:intensity = 1600
        double3 xformOp:rotateXYZ = (-45, 30, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "SkyLight"
    {
        color3f inputs:color = (0.75, 0.88, 1)
        float inputs:intensity = 550
    }

    def Scope "Looks"
    {
        def Material "GroundMat"
        {
            token outputs:surface.connect = </World/Looks/GroundMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/GroundMat/PrimvarReader.outputs:result>
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                float inputs:specular = 0.03
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                color3f inputs:fallback = (0.28, 0.2, 0.13)
                token inputs:varname = "displayColor"
                color3f outputs:result
            }
        }

        def Material "FurrowMat"
        {
            token outputs:surface.connect = </World/Looks/FurrowMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/FurrowMat/PrimvarReader.outputs:result>
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                float inputs:specular = 0.03
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                color3f inputs:fallback = (0.2, 0.14, 0.08)
                token inputs:varname = "displayColor"
                color3f outputs:result
            }
        }

        def Material "PlantMat"
        {
            token outputs:surface.connect = </World/Looks/PlantMat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/PlantMat/PrimvarReader.outputs:result>
                float inputs:metallic = 0
                float inputs:roughness = 0.78
                float inputs:specular = 0.05
                token outputs:surface
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                color3f inputs:fallback = (0.16, 0.5, 0.12)
                token inputs:varname = "displayColor"
                color3f outputs:result
            }
        }
    }

